# ── AI Finance Copilot — Environment Variables ──
# Copy this file to .env.local for local development.
# On Vercel, add these in Settings → Environment Variables.
# All variables are OPTIONAL — the app runs in demo mode without them.

# ── Supabase (Auth, Chat, Portfolio sync) ──
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Groq AI (Stock predictions & financial advisor) ──
# Get a free key at https://console.groq.com
VITE_GROQ_API_KEY=your-groq-api-key

# ── Groww Trading API (Live trading, portfolio sync) ──
# Apply at https://groww.in/developer
VITE_GROWW_API_KEY=your-groww-api-key
VITE_GROWW_API_SECRET_KEY=your-groww-api-secret

# ── Notes ──
# • Market data (stock charts) works without any API keys — uses Groww public
#   data endpoints and Yahoo Finance as fallback layers.
# • Without Supabase: auth/login is disabled, use "Demo Mode" instead.
# • Without Groq: AI predictions fall back to basic technical analysis.
# • Without Groww keys: live trading is disabled, paper trading still works.
