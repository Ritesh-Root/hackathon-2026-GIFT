# ─── AI Finance Copilot — Environment Variables ───
#
# Copy this file to .env.local and fill in the values you need.
# ALL variables are OPTIONAL — the app runs in demo mode without them.
#
# For market data: NO API KEY IS NEEDED.
# Yahoo Finance is used via session-based auth handled automatically
# by the Vercel API routes (api/stock-quote.ts, api/stock-candles.ts).

# ─── Supabase (optional) ───
# Enables: user auth, prediction history, community chat, portfolio persistence.
# Get these from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Groq AI (optional) ───
# Enables: AI stock predictions and AI financial advisor chat.
# Get a free key from https://console.groq.com/keys
VITE_GROQ_API_KEY=

# ─── Groww Trading API (optional) ───
# Enables: live brokerage integration (quotes, holdings, order placement).
# Get keys from Groww's developer portal.
VITE_GROWW_API_KEY=
VITE_GROWW_API_SECRET_KEY=
